# ---------------------------------------------------------------------------
# Admin portal — sign-in
# ---------------------------------------------------------------------------
# Set these and the portal requires a sign-in. Leave them unset and the portal
# stays open on a local machine, and is REFUSED OUTRIGHT on a deployed host —
# it can edit the live catalogue, so it fails closed rather than open.
#
# Use a long password. Unless ADMIN_SESSION_SECRET is set below, it is also the
# key the session cookie is signed with.
ADMIN_PASSWORD=
# Optional. Defaults to "admin".
ADMIN_USERNAME=
# Optional but recommended: 32+ random characters, separate from the password,
# so that changing the password is not the same thing as rotating the signing
# key. Generate one with:  openssl rand -base64 32
ADMIN_SESSION_SECRET=

# ---------------------------------------------------------------------------
# Catalogue store
# ---------------------------------------------------------------------------
# Unset locally: edits are written to .data/catalogue.json. Nothing to install.
#
# On Vercel the filesystem is ephemeral and read-only, so a store is required
# before the portal can save anything. Adding a KV database in the Vercel
# dashboard sets both of these for you; a bare Upstash database exports the
# UPSTASH_REDIS_REST_* names instead and those are read too.
KV_REST_API_URL=
KV_REST_API_TOKEN=
